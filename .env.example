# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요. (.env 는 절대 남에게 공유하지 마세요)

OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-api03-...

# 화자 언어. 비워두면 자동 감지(영어·일본어 등 섞여도 됨). 한 언어로 고정하려면 코드 입력: en ja zh de fr es ...
SOURCE_LANG=

# 자막 언어 (번역 목표). 자연어 이름으로: 한국어, English, 日本語, 中文 ...
TARGET_LANG=한국어

# 화자가 이미 자막 언어(한국어)로 말하면 이 언어로 번역. 비우면 한국어는 그대로 표시
REVERSE_LANG=English

# 실행할 때마다 언어 선택 창 띄우기 (0 이면 위 설정으로 바로 시작)
# ASK_LANG=0

# 번역 방식: quality = 문장 끝까지 듣고 상위 모델(Sonnet)로 번역, 지연 3~4초 / fast = 1~2초, 문장이 잘게 끊김
MODE=quality

# 회의 종료(창 닫기) 후 전체 내용을 다른 언어로도 저장. 여러 개는 쉼표로. 비우면 안 함
# EXTRA_SAVE_LANGS=日本語

# 고유명사·전문용어 고정 번역 (쉼표로 구분). license=라이센스 등 IT 기본 용어는 이미 내장, 여기 쓴 것이 우선
# GLOSSARY=AICC=AI 컨택센터, CX=고객경험

# 영어 그대로 둘 제품·회사명 추가 (Mitel, MiCollab, MiVoice, MX-ONE, OpenScape 등은 이미 내장)
# PRODUCT_TERMS=고객사명, 신제품명

# 선택 사항
# CHUNK_SEC=8              # 한 발화 최대 길이(초). MODE 기본값을 덮어씀
# PAUSE_SEC=0.6            # 이만큼 말이 끊기면 문장 끝으로 판단. MODE 기본값을 덮어씀
# TRANSLATE_MODEL=claude-sonnet-5-5   # 번역 모델 직접 지정 (안 되면 자동으로 다른 모델 시도)
# STT_MODEL=whisper-1      # gpt-4o-mini-transcribe 가 안 되면 이걸로
# CAPTION_DEVICE=BlackHole # 입력 장치 이름 일부
# CAPTION_SAVE_DIR=/Users/me/Documents   # 자막 저장 폴더
# CAPTURE_MIC=0            # 내 마이크는 인식하지 않음 (기본: 마이크도 같이 인식, "(나)" 표시)
# MIC_SILENCE_RMS=0.0012   # 내 말이 인식 안 되면 낮추고, 잡음까지 잡히면 높임
# SILENCE_RMS=0.005        # 상대방(스피커) 소리 기준
# KO_SIZE=15               # 번역문 글자 크기
# EN_SIZE=11               # 원문 글자 크기
