# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요. (.env 는 절대 남에게 공유하지 마세요)

OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-api03-...

# 화자 언어. 비워두면 자동 감지(영어·일본어 등 섞여도 됨). 한 언어로 고정하려면 코드 입력: en ja zh de fr es ...
SOURCE_LANG=

# 자막 언어 (번역 목표). 자연어 이름으로: 한국어, English, 日本語, 中文 ...
TARGET_LANG=한국어

# 선택 사항
# CHUNK_SEC=4              # 한 발화 최대 길이(초). 말이 끊기면 그 전에 바로 전송됨
# PAUSE_SEC=0.35           # 이만큼 말이 끊기면 문장 끝으로 판단
# STT_MODEL=whisper-1      # gpt-4o-mini-transcribe 가 안 되면 이걸로
# CAPTION_DEVICE=BlackHole # 입력 장치 이름 일부
# CAPTION_SAVE_DIR=/Users/me/Documents   # 자막 저장 폴더
# KO_SIZE=15               # 번역문 글자 크기
# EN_SIZE=11               # 원문 글자 크기
